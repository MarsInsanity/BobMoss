#!/bin/bash
# RK3399 (Anbernic RG552) system-sleep hook.

case $1 in
  pre)
    # Blank first so sleep feels immediate.
    cat /sys/class/backlight/backlight/brightness > /var/local/cur_bright.state 2>/dev/null
    echo 0 > /sys/class/backlight/backlight/brightness 2>/dev/null
    /usr/sbin/alsactl store -f /var/local/asound.state
    if [ -f "/usr/local/bin/quickmode.sh" ]; then
      touch /dev/shm/.JUSTWOKEUP
    fi
    # The out-of-tree RTL8188FU driver does not survive suspend: take it down
    # and bring it back on wake, where NetworkManager reconnects.
    if lsmod | grep -q '^rtl8188fu'; then
      touch /run/rg552-wifi-was-loaded
      modprobe -r rtl8188fu
    fi
    # Quiet fan while asleep; rg552-fan sets it again on its next tick.
    for h in /sys/class/hwmon/hwmon*; do
      [ "$(cat $h/name 2>/dev/null)" = pwmfan ] && echo 1 > $h/pwm1 2>/dev/null
    done
    ;;
  post)
    [ -s /var/local/cur_bright.state ] && cat /var/local/cur_bright.state > /sys/class/backlight/backlight/brightness
    /usr/sbin/alsactl restore -f /var/local/asound.state
    if [ -f /run/rg552-wifi-was-loaded ]; then
      rm -f /run/rg552-wifi-was-loaded
      modprobe rtl8188fu
    fi
    systemctl is-active --quiet rg552-fan && systemctl kill -s USR1 rg552-fan
    ;;
esac
