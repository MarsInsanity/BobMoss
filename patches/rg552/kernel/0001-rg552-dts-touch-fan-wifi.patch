+	/*
+	 * dArkMoss: GT927 through the in-tree goodix driver. Its reset line is
+	 * released by the hog on gpio3 below, with INT pulled up, which selects
+	 * address 0x14. Coordinates are reported in the panel's native portrait
+	 * frame (1152x1920); userspace applies the 270 degree panel rotation.
+	 */
+	touchscreen@14 {
+		compatible = "goodix,gt927";
+		reg = <0x14>;
+		interrupt-parent = <&gpio3>;
+		interrupts = <RK_PD7 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_int>;
+		/*
+		 * The driver resets the GT927 with these at probe (patch 0003),
+		 * as ROCKNIX's mainline goodix does; without the reset it came up
+		 * with an empty config and never reported a touch.
+		 */
+		irq-gpios = <&gpio3 RK_PD7 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio3 RK_PD6 GPIO_ACTIVE_HIGH>;
+		touchscreen-size-x = <1152>;
+		touchscreen-size-y = <1920>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
+		status = "okay";
+	};
 
 
 };
 
