+/*
+ * Reset the controller the way mainline does since 4.5 (ec6e1b4082d9): the
+ * level of INT while RST is released picks the I2C address, then INT is
+ * pulsed low before it goes back to being the interrupt input. Without it a
+ * GT9xx can come up without its configuration (resolution 0, no reports).
+ * RST stays driven high afterwards: nothing else holds it up on the RG552.
+ */
+static int goodix_int_sync(struct goodix_ts_data *ts)
+{
+	int error;
+
+	error = gpiod_direction_output(ts->gpiod_int, 0);
+	if (error)
+		return error;
+	msleep(50);				/* T5: 50ms */
+	return gpiod_direction_input(ts->gpiod_int);
+}
+
+static int goodix_reset(struct goodix_ts_data *ts)
+{
+	int error;
+
+	/* begin select I2C slave addr */
+	error = gpiod_direction_output(ts->gpiod_rst, 0);
+	if (error)
+		return error;
+	msleep(20);				/* T2: > 10ms */
+	/* HIGH: 0x28/0x29 (0x14), LOW: 0xBA/0xBB (0x5d) */
+	error = gpiod_direction_output(ts->gpiod_int, ts->client->addr == 0x14);
+	if (error)
+		return error;
+	usleep_range(100, 2000);		/* T3: > 100us */
+	error = gpiod_direction_output(ts->gpiod_rst, 1);
+	if (error)
+		return error;
+	usleep_range(6000, 10000);		/* T4: > 5ms */
+	/* end select I2C slave addr */
+	return goodix_int_sync(ts);
+}
+
+static int goodix_get_gpio_config(struct goodix_ts_data *ts)
+{
+	struct device *dev = &ts->client->dev;
+	struct gpio_desc *gpiod;
+
+	gpiod = devm_gpiod_get_optional(dev, "irq", GPIOD_IN);
+	if (IS_ERR(gpiod))
+		return PTR_ERR(gpiod);
+	ts->gpiod_int = gpiod;
+
+	gpiod = devm_gpiod_get_optional(dev, "reset", GPIOD_IN);
+	if (IS_ERR(gpiod))
+		return PTR_ERR(gpiod);
+	ts->gpiod_rst = gpiod;
+
+	return 0;
+}
+
 static int goodix_ts_probe(struct i2c_client *client,
 			   const struct i2c_device_id *id)
 {
